{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/home",
      "destination": "/"
    },
    {
      "source": "/about/principals-message",
      "destination": "/about.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/programmes",
      "destination": "/programmes.html"
    },
    {
      "source": "/infrastructure",
      "destination": "/infrastructure.html"
    },
    {
      "source": "/beyond-academics",
      "destination": "/beyond-academics.html"
    },
    {
      "source": "/admissions",
      "destination": "/admissions.html"
    },
    {
      "source": "/admission-process",
      "destination": "/admissions.html"
    },
    {
      "source": "/careers",
      "destination": "/careers.html"
    },
    {
      "source": "/faqs",
      "destination": "/faqs.html"
    },
    {
      "source": "/contact",
      "destination": "/contact-us.html"
    },
    {
      "source": "/contact-us",
      "destination": "/contact-us.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
